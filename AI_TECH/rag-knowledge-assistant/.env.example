# Copy to .env and fill in. Never commit .env (it is in .gitignore).
OPENAI_API_KEY=sk-replace-me
# Clients send this in the X-API-Key header. Comma-separate several keys. Use long random values.
API_KEYS=replace-with-a-long-random-key
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# openai for real use; hashing runs fully offline (word overlap only) for demos
EMBEDDER=openai
CHUNK_CHARS=800
CHUNK_OVERLAP=120
TOP_K=4
# Relevance floor. Calibrate with scripts/eval_retrieval.py on your own documents.
MIN_SCORE=0.30
MAX_UPLOAD_BYTES=5000000
