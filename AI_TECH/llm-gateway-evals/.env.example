# Copy to .env and fill in. Never commit .env (it is in .gitignore).
OPENAI_API_KEY=sk-replace-me
# name:secret pairs. Each client sends its secret in the X-API-Key header.
API_KEYS=team-a:replace-with-a-long-random-key,team-b:another-long-random-key
ALLOWED_MODELS=gpt-4.1-mini
DEFAULT_MODEL=gpt-4.1-mini
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=300
MAX_RETRIES=2
BACKOFF_BASE_SECONDS=0.5
# USD per 1M tokens as {"model": [input, output]}. Defaults assume gpt-4.1-mini at 0.40 / 1.60.
# Verify against the provider's current pricing page before trusting cost figures.
# PRICING_JSON={"gpt-4.1-mini": [0.40, 1.60]}
